# Copy to .env and adjust. .env is git-ignored and excluded from Docker builds (.dockerignore).

# Database. POSTGRES_PORT is the port published on the host for local tools (.venv tests, the MCP
# server, go run); containers always reach the database at db:5432.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
POSTGRES_PORT=5432

# Host port for the Go API container, published on 127.0.0.1 only. Change it if 8080 is in use
# (for example by a local `go run ./cmd/api`).
API_PORT=8080

# OpenAI key for the Python RAG container. Compose reads it from the shell environment first and
# falls back to this file, so use one of:
#   - leave it empty here and export it in the shell that runs `docker compose`
#     (e.g. `. ~/.config/openai/env`, the file local .venv runs already use), or
#   - put it here (keep .env private: chmod 600 .env).
# Left empty, the services still start and become healthy; queries fail with configuration_error.
OPENAI_API_KEY=

# Optional generation settings; empty means the defaults in rag/generator.py.
RAG_GENERATION_MODEL=
RAG_REASONING_EFFORT=
